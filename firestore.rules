rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isGroupMember(groupId) {
      return isAuthenticated() && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    function isGroupAdmin(groupId) {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role in ['ADMIN', 'admin'];
    }

    // Top-level invite code resolution (prevents enumeration of groups)
    match /inviteCodes/{code} {
      // Readable by exact get only; list is denied to prevent enumerating groups
      allow get: if isAuthenticated();
      allow list: if false;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        isGroupAdmin(resource.data.groupId) ||
        resource.data.createdBy == request.auth.uid
      );
    }

    // User profiles & FCM tokens
    match /users/{userId} {
      // User can read self, or fellow family group members if currentGroupId is set
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        (resource.data.currentGroupId != null && isGroupMember(resource.data.currentGroupId))
      );
      allow write: if isUser(userId);

      match /fcmTokens/{tokenId} {
        allow read, write: if isUser(userId);
      }
    }

    // Family groups
    match /groups/{groupId} {
      allow read: if isGroupMember(groupId);
      allow create: if isAuthenticated();
      allow update, delete: if isGroupAdmin(groupId);

      match /members/{memberId} {
        allow read: if isGroupMember(groupId);
        
        // Privilege escalation protection:
        // Admin can add members. Prospective member joining can ONLY set role to MEMBER,
        // unless creating the initial group doc.
        allow create: if isAuthenticated() && (
          isGroupAdmin(groupId) ||
          (request.auth.uid == memberId && (
            request.resource.data.role in ['MEMBER', 'member'] ||
            !exists(/databases/$(database)/documents/groups/$(groupId))
          ))
        );

        // Member cannot promote themselves to ADMIN
        allow update: if isGroupAdmin(groupId) || (
          request.auth.uid == memberId && 
          request.resource.data.role == resource.data.role
        );

        allow delete: if isGroupAdmin(groupId) || (request.auth.uid == memberId);
      }

      match /medicines/{medicineId} {
        allow read: if isGroupMember(groupId);
        allow create, update, delete: if isGroupAdmin(groupId);
      }

      match /schedules/{scheduleId} {
        allow read: if isGroupMember(groupId);
        allow create, update, delete: if isGroupAdmin(groupId);
      }

      match /doseEvents/{eventId} {
        allow read: if isGroupMember(groupId);
        
        // Members can only log their own doses; admins can log for anyone in the group
        allow create: if isGroupMember(groupId) && (
          isGroupAdmin(groupId) ||
          request.resource.data.assignedMemberId == request.auth.uid
        );

        // Members can only update their own doses and cannot reassign assignedMemberId
        allow update: if isGroupMember(groupId) && (
          isGroupAdmin(groupId) || (
            resource.data.assignedMemberId == request.auth.uid &&
            request.resource.data.assignedMemberId == request.auth.uid &&
            request.resource.data.medicineId == resource.data.medicineId &&
            request.resource.data.scheduledAt == resource.data.scheduledAt
          )
        );

        allow delete: if isGroupAdmin(groupId);
      }
    }
  }
}
