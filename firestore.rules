rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isGroupMember(groupId) {
      return isAuthenticated() && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    function isGroupAdmin(groupId) {
      return isAuthenticated() && get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role in ['ADMIN', 'admin'];
    }

    // User profiles & FCM tokens
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isUser(userId);

      match /fcmTokens/{tokenId} {
        allow read, write: if isUser(userId);
      }
    }

    // Family groups
    match /groups/{groupId} {
      allow read: if isGroupMember(groupId);
      allow create: if isAuthenticated();
      allow update, delete: if isGroupAdmin(groupId);

      match /members/{memberId} {
        allow read: if isGroupMember(groupId);
        // Admin can manage members; a user can join (create their own member record with an invite)
        allow create: if isAuthenticated() && (request.auth.uid == memberId || isGroupAdmin(groupId));
        allow update, delete: if isGroupAdmin(groupId) || (request.auth.uid == memberId);
      }

      match /medicines/{medicineId} {
        allow read: if isGroupMember(groupId);
        allow create, update, delete: if isGroupAdmin(groupId);
      }

      match /schedules/{scheduleId} {
        allow read: if isGroupMember(groupId);
        allow create, update, delete: if isGroupAdmin(groupId);
      }

      match /doseEvents/{eventId} {
        allow read: if isGroupMember(groupId);
        // Members can create/update dose events (e.g., mark Taken, Skipped, Snoozed)
        allow create, update: if isGroupMember(groupId);
        allow delete: if isGroupAdmin(groupId);
      }
    }
  }
}
